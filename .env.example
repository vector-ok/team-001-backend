# Copy to .env and fill in the values before running the API locally.

# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MongoDB connection string. Point this at a local mongod or an Atlas cluster.
STRING=mongodb://127.0.0.1:27017/betalife

# Auth. Use a long random value, never the example below.
JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRES_IN=24h
