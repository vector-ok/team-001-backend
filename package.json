{
  "name": "betalife-backend",
  "version": "1.0.0",
  "description": "REST API for Betalife: events, funding opportunities, announcements and role aware accounts",
  "private": true,
  "main": "src/index.js",
  "directories": {
    "test": "__tests__"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cover": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.js\" \"__tests__/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"__tests__/**/*.js\"",
    "audit": "npm audit --audit-level=high",
    "prepare": "husky || true"
  },
  "author": {
    "name": "Build For SDG",
    "email": "buildforsdg@andela.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vector-ok/team-001-backend.git"
  },
  "bugs": {
    "url": "https://github.com/vector-ok/team-001-backend/issues"
  },
  "homepage": "https://github.com/vector-ok/team-001-backend#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-fileupload": "^1.5.2",
    "joi": "^18.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@eslint/js": "^9.39.0",
    "babel-jest": "^30.5.2",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "7.0.28"
    }
  }
}
